{
  "name": "yonder",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.3",
  "engines": {
    "node": ">=22.19"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "concurrently -k -n app,collab,worker -c blue,magenta,yellow \"vite dev\" \"tsx watch --env-file=.env collab/server.ts\" \"tsx watch --env-file=.env collab/worker.ts\"",
    "dev:app": "vite dev",
    "dev:collab": "tsx watch --env-file=.env collab/server.ts",
    "dev:worker": "tsx watch --env-file=.env collab/worker.ts",
    "dev:all": "concurrently -k -n app,collab,worker -c blue,magenta,yellow \"vite dev\" \"tsx watch --env-file=.env collab/server.ts\" \"tsx watch --env-file=.env collab/worker.ts\"",
    "build": "vite build && pnpm build:collab && pnpm build:scripts",
    "build:collab": "esbuild collab/server.ts collab/worker.ts --bundle --platform=node --target=node22 --format=esm --outdir=.output/collab --out-extension:.js=.mjs --external:sharp --external:geo-tz --external:@tanstack/react-start --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\" && esbuild scripts/media-regenerate.ts --bundle --platform=node --target=node22 --format=esm --outdir=.output/collab --out-extension:.js=.mjs --external:sharp --external:geo-tz --external:@tanstack/react-start --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
    "build:scripts": "esbuild scripts/migrate.ts scripts/setup-bucket.ts scripts/set-quota.ts --bundle --platform=node --target=node22 --format=esm --outdir=.output/scripts --out-extension:.js=.mjs --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
    "start": "node --env-file-if-exists=.env .output/server/index.mjs",
    "start:collab": "node --env-file-if-exists=.env .output/collab/server.mjs",
    "start:worker": "node --env-file-if-exists=.env .output/collab/worker.mjs",
    "collab:start": "pnpm start:collab",
    "worker:start": "pnpm start:worker",
    "typecheck": "tsr generate && tsc --noEmit",
    "generate-routes": "tsr generate",
    "lint": "biome lint",
    "format": "biome format --write",
    "check": "biome check",
    "check:fix": "biome check --write",
    "check:shutdown": "tsx scripts/check-shutdown.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "bash e2e/pw.sh playwright test -c playwright.app.config.ts",
    "e2e:fast": "tsx scripts/e2e-fast.ts",
    "e2e:template": "tsx scripts/e2e-template.ts",
    "db:up": "docker compose up -d --wait postgres s3proxy redis",
    "db:create": "tsx --env-file=.env scripts/db-create.ts",
    "db:reset": "tsx --env-file=.env scripts/db-reset.ts",
    "db:test:prepare": "tsx --env-file=.env scripts/db-test-prepare.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --env-file=.env scripts/seed-dev.ts",
    "db:seed:qa": "tsx --env-file=.env scripts/seed-qa.ts",
    "s3:init": "tsx --env-file=.env scripts/s3-init.ts",
    "s3:setup": "tsx --env-file=.env scripts/setup-bucket.ts",
    "quota:set": "tsx --env-file=.env scripts/set-quota.ts",
    "media:regenerate": "tsx --env-file=.env scripts/media-regenerate.ts",
    "vapid:keys": "tsx scripts/vapid-keys.ts",
    "auth:generate": "auth generate --config src/server/auth.server.ts --output src/db/schema/auth.ts --yes",
    "agent:env": "tsx scripts/agent-env.ts",
    "countries": "tsx scripts/build-countries.ts",
    "airports": "tsx scripts/build-airports.ts",
    "airlines": "tsx scripts/build-airlines.ts",
    "data:jp": "tsx scripts/build-jp-rail.ts",
    "map:styles": "tsx scripts/build-map-styles.ts",
    "sheet:import": "tsx --env-file=.env scripts/sheet/import-asia-2027.ts",
    "purge": "tsx --env-file=.env scripts/purge.ts",
    "cleanup:test-data": "tsx --env-file=.env scripts/cleanup-test-data.ts"
  },
