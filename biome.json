{
	"$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"ignoreUnknown": true,
		"includes": [
			"src/**",
			"collab/**",
			"scripts/**",
			"vite.config.ts",
			"vitest.config.ts",
			"drizzle.config.ts",
			"sw.config.ts",
			"!src/routeTree.gen.ts",
			"!src/styles.css",
			"!src/data/*.json",
			"!src/data/jp-rail",
			"!**/__fixtures__"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"overrides": [
		{
			"includes": ["src/components/ui/**"],
			"linter": { "enabled": false }
		}
	]
}
