# Yonder environment. Every variable the app, collab/worker process, scripts and
# docker-compose read. Local defaults below work with `docker compose up -d --wait`.
# NEVER `cp .env.example .env` over an existing .env (it holds real secrets):
# add missing keys by hand, or with `pnpm agent:env` once that script exists.
# Secrets: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Only VITE_* values reach the browser bundle, and they are inlined at BUILD time.

# ---- App ----
APP_NAME=Yonder
APP_URL=http://localhost:3000
APP_PORT=3000                      # vite dev port (vite.config.ts reads it); parallel agents get their own (SPEC §5.7)
PORT=3000                          # `pnpm start` (Nitro) port; keep equal to APP_PORT
TRUSTED_ORIGINS=                   # comma list, e.g. http://192.168.1.20:3000 for phone testing

# ---- Database: compose service `postgres`, 127.0.0.1:5432 ----
DATABASE_URL=postgres://trip:trip@localhost:5432/trip
DATABASE_URL_TEST=postgres://trip:trip@localhost:5432/trip_test
# POSTGRES_PASSWORD=               # compose only; defaults to "trip" in dev, must be random in prod

# ---- Object storage: compose service `s3proxy`, 127.0.0.1:8080, path-style ----
S3_ENDPOINT=http://localhost:8080          # server -> S3
S3_PUBLIC_ENDPOINT=http://localhost:8080   # the host the BROWSER uses; presigned URLs are signed for it
S3_PUBLIC_URL=http://localhost:8080/trip-media   # read only by infra/verify-s3.mjs; the app ignores it
S3_REGION=us-east-1
S3_BUCKET=trip-media
S3_ACCESS_KEY_ID=trip-local
S3_SECRET_ACCESS_KEY=trip-local-secret
S3_FORCE_PATH_STYLE=true
# compose -> s3proxy CORS (space-separated Java regexes). Single quotes keep the backslashes literal.
S3_CORS_ORIGINS='http://(localhost|127\.0\.0\.1)(:[0-9]+)?'
STORAGE_QUOTA_DEFAULT_GB=5         # per-account storage quota (ADDENDUM §12); per-user override: pnpm quota:set <email> <GB|default>

# ---- Redis: compose service `redis`, 127.0.0.1:6379 (ADDENDUM §2) ----
# Pub/sub for live trip invalidation (channel <REDIS_PREFIX>:trip:<tripId>), Hocuspocus
# extension-redis, BullMQ queues, Better Auth secondary storage, TTL caches.
REDIS_URL=redis://localhost:6379
# Namespace for EVERY key, channel and queue. Pub/sub ignores the db number in
# REDIS_URL, so parallel agents sharing one Redis must each use their own prefix
# (e.g. yonder-a3), exactly like their own database and bucket.
REDIS_PREFIX=yonder

# ---- Auth (Better Auth, email OTP) ----
BETTER_AUTH_SECRET=                # generate with the node one-liner at the top
BETTER_AUTH_URL=http://localhost:3000
DEV_FIXED_OTP=000000               # every OTP is this; the server refuses to start with it unless BETTER_AUTH_URL is localhost/127.0.0.1
AUTH_RATE_LIMIT=                   # "off" disables Better Auth rate limits; honoured only for localhost URLs (tests)
# Cloudflare Turnstile on the sign-in email step: on only when BOTH are set (read at runtime).
# Test keys: site 1x00000000000000000000AA (passes) / secret 1x0000000000000000000000000000000AA (passes),
# 2x0000000000000000000000000000000AA (fails).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TRUST_CF_CONNECTING_IP=            # "1" behind Cloudflare: rate limits key on CF-Connecting-IP before X-Forwarded-For

# ---- Email: Resend if RESEND_API_KEY, else SMTP if SMTP_HOST, else console (production refuses to start without one) ----
EMAIL_FROM="Yonder <trips@localhost>"
RESEND_API_KEY=
SMTP_HOST=                         # `docker compose --profile mail up -d mailpit` -> localhost:1025, UI :8025
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_OUTBOX_DIR=                  # e.g. .data/outbox: also write every email as JSON (localhost URLs only)

# ---- Realtime: collab (Hocuspocus) + job worker process ----
HOCUSPOCUS_PORT=1234
HOCUSPOCUS_HOST=                   # bind address; empty = 127.0.0.1 in dev (behind the Vite proxy), 0.0.0.0 with NODE_ENV=production
COLLAB_RUN_WORKER=                 # "1" also runs the BullMQ worker inside the collab process (`pnpm dev` already starts collab/worker.ts)
VITE_COLLAB_URL=                   # leave EMPTY: the browser uses same-origin /collab (Vite proxies it in dev, the ingress routes it in prod)
HOCUSPOCUS_URL=ws://localhost:1234 # direct URL for Node-side clients (scripts, tests); browsers never read it

# ---- Web Push notifications: app, collab and worker all read these; push is off while any is empty ----
VAPID_PUBLIC_KEY=                  # `pnpm vapid:keys` prints a fresh pair
VAPID_PRIVATE_KEY=                 # secret; a new pair makes every device subscribe again
VAPID_SUBJECT=                     # contact for push services, e.g. mailto:support@yonder.sh

# ---- Media processing (worker) ----
FFMPEG_PATH=                       # empty = `ffmpeg` on PATH. NixOS: nix build nixpkgs#ffmpeg-headless.bin --no-link --print-out-paths, + /bin/ffmpeg
FFPROBE_PATH=                      # empty = `ffprobe` on PATH (same package)
PDFTOPPM_PATH=                     # empty = `pdftoppm` on PATH (poppler-utils; pdfinfo next to it). NixOS: nix build nixpkgs#poppler-utils --no-link --print-out-paths, + /bin/pdftoppm

# ---- Maps and routing (all optional) ----
GOOGLE_MAPS_API_KEY=               # Places API (New) + Routes API; server-side only
ODPT_CONSUMER_KEY=                 # v1.1 Tokyo subway timetable refinement (ADDENDUM §5); unused in v1
NAVITIME_RAPIDAPI_KEY=             # unused: NAVITIME is dropped (ADDENDUM §5); the provider stays a stub
GOOGLE_PLACES_URL=https://places.googleapis.com
GOOGLE_ROUTES_URL=https://routes.googleapis.com
NAVITIME_URL=https://navitime-route-totalnavi.p.rapidapi.com
OSRM_FOOT_URL=https://routing.openstreetmap.de/routed-foot
PHOTON_URL=https://photon.komoot.io
OSM_CONTACT=                       # an email or URL the deployer controls; sent in the User-Agent to FOSSGIS/Photon
AUTOFILL_MAX_PROVIDER_CALLS_PER_TRIP_PER_DAY=300
JP_RAIL_DIR=                       # empty = src/data/jp-rail (built by `pnpm data:jp`; the Docker images copy it there)

# ---- Climate (E3) and FX (E5), EXTENSIONS §11 / ADDENDUM §7.3 ----
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com
OPEN_METEO_API_KEY=                # only for the paid customer-archive-api (non-commercial free tier otherwise)
CLIMATE_ENABLED=true
FX_URL=https://cdn.jsdelivr.net/npm/@fawazahmed0/currency-api@latest/v1   # covers TWD and VND; per-date: @<YYYY-MM-DD>
FX_FALLBACK_URL=https://latest.currency-api.pages.dev/v1                  # currency-api mirror; per-date host: <YYYY-MM-DD>.currency-api.pages.dev
FX_CHECK_URL=https://api.frankfurter.dev/v2                              # optional cross-check (no TWD/VND)

# ---- Tests (localhost URLs only) ----
ENABLE_TEST_ROUTES=                # "1" enables POST /api/test/fixture
VITE_E2E=                          # "1" exposes window.__yonder and window.__tripMap
